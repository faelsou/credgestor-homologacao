            {
              "type": "query",
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "evaluator": {
                "params": [0],
                "type": "gt"
              }
            }
          ],
          "executionErrorState": "alerting",
          "noDataState": "no_data",
          "for": "1m"
        }
      },
      {
        "id": 5,
        "title": "Erro em CRUD de Parcelas",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(installment_crud_errors_total[5m])",
            "refId": "A"
          }
        ],
        "alert": {
          "name": "InstallmentCRUDError",
