        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  t.name as tenant,\n  COUNT(DISTINCT c.id) as \"Clientes\",\n  COUNT(DISTINCT l.id) as \"Empréstimos\",\n  COUNT(DISTINCT i.id) as \"Parcelas\",\n  COALESCE(SUM(CASE WHEN i.status = 'paid' THEN i.amount ELSE 0 END), 0) as \"Valor Pago\",\n  COALESCE(SUM(CASE WHEN i.status != 'paid' AND i.due_date < CURRENT_DATE THEN i.amount ELSE 0 END), 0) as \"Valor Vencido\"\nFROM tenants t\nLEFT JOIN clients c ON t.id = c.tenant_id\nLEFT JOIN loans l ON t.id = l.tenant_id\nLEFT JOIN installments i ON l.id = i.loan_id\nWHERE t.ativo = true\nGROUP BY t.id, t.name\nORDER BY \"Clientes\" DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top 10 Tenants por Volume",
      "type": "table"
    }
