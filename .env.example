# ===================================================================
# CREDGESTOR - Variáveis de Ambiente
# ===================================================================
# Copie este arquivo para .env e preencha com seus valores reais
# cp .env.example .env

# ===================================================================
# BACKEND - Configuração Supabase (FastAPI)
# ===================================================================

# URL do projeto Supabase (obrigatória)
# Exemplo: https://seu-projeto.supabase.co
SUPABASE_URL=

# Service Role Key do Supabase (obrigatória)
# ⚠️  NUNCA exponha esta chave no frontend!
# Ela permite bypass de Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Anon Key do Supabase (opcional, necessária apenas para autenticação)
# Usada para operações de autenticação de usuários
SUPABASE_ANON_KEY=

# Tenant ID padrão (opcional)
# Usado quando o usuário não especifica um tenant_id no login
DEFAULT_TENANT_ID=

# ===================================================================
# BACKEND LEGACY - Configuração PostgreSQL Direta
# ===================================================================
# ⚠️  ATENÇÃO: Estes arquivos legacy usam psycopg2 diretamente
# Considere migrar para usar Supabase ao invés disso

# String de conexão PostgreSQL (para código legacy)
# Formato: postgresql://usuario:senha@host:porta/database
# Exemplo: postgresql://postgres:senha@db.projeto.supabase.co:5432/postgres
DATABASE_URL=

# ===================================================================
# FRONTEND - Configuração Supabase (Vite/React)
# ===================================================================

# URL do projeto Supabase para o frontend
# Exemplo: https://seu-projeto.supabase.co
VITE_SUPABASE_URL=

# Anon Key do Supabase para o frontend
# Esta chave é segura para expor no frontend (tem RLS habilitado)
VITE_SUPABASE_ANON_KEY=

# ===================================================================
# FRONTEND - Configuração Backend N8N (Opcional)
# ===================================================================

# URL base da API N8N (opcional)
# Se configurado, o frontend usará este backend ao invés do Supabase direto
# Exemplo: http://localhost:5678 ou https://api.seudominio.com
VITE_N8N_BASE_URL=

# URL específica para login (opcional, sobrescreve VITE_N8N_BASE_URL/auth/login)
VITE_API_LOGIN_URL=

# Tenant ID padrão para N8N (opcional)
VITE_N8N_TENANT_ID=
VITE_API_TENANT_ID=

# ===================================================================
# DOCKER - Configuração (Opcional)
# ===================================================================

# Host da API (padrão: 0.0.0.0)
API_HOST=0.0.0.0

# Porta da API (padrão: 8000)
API_PORT=8000

# ===================================================================
# AGENTE AIOps - Slack
# ===================================================================
# Documentação completa: AIOPS_AGENTE.md

# Bot token (xoxb-...) - necessário para as mensagens com botões de aprovação
SLACK_BOT_TOKEN=

# Signing Secret do Slack App - 32 caracteres hexadecimais
# ⚠️  Não confundir com o Verification Token (24 caracteres): com o valor errado
# todas as interações dos botões são recusadas com HTTP 403
SLACK_SIGNING_SECRET=

# Webhook - fallback de envio quando não há bot token (mensagens sem botões)
SLACK_WEBHOOK_URL=

# Canal de destino dos alertas
SLACK_CHANNEL=#credgestor-agent

# ===================================================================
# AGENTE AIOps - LLM (troubleshooting)
# ===================================================================

# Provedor: anthropic ou openai
LLM_PROVIDER=anthropic

# Modelo - modelos claude-3-5-* foram aposentados e retornam 404
LLM_MODEL=claude-sonnet-4-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===================================================================
# AGENTE AIOps - Comportamento
# ===================================================================

# Stack monitorada no Docker Swarm
DOCKER_STACK=credgestor

# URLs das sondagens (pública × interna)
API_URL=https://credgestor.app.br/api
API_INTERNAL_URL=http://credgestor_api:8000
API_LIVE_ENDPOINT=/health/live
API_HEALTH_ENDPOINT=/health
FRONTEND_URL=https://credgestor.app.br

# Limites das sondagens
PROBE_DB_SLOW_MS=3000
PROBE_HOST_MEMORY_MIN_PERCENT=10
PROBE_HOST_DISK_MAX_PERCENT=85
PROBE_HTTP_TIMEOUT=15

# Status saudável periódico (segundos)
SEND_HEALTHY_STATUS=true
MONITOR_INTERVAL=3600
HEALTHY_STATUS_INTERVAL=3600

# Lembrete de incidente em aberto (segundos)
REALERT_INTERVAL=900

# Aprovação humana antes de qualquer ação corretiva
# ⚠️  Mantenha APPROVAL_TIMEOUT menor que REALERT_INTERVAL para que o lembrete
# reabra o pedido em vez de encontrá-lo pendente
REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT=600

# Porta do receptor de aprovações do Slack (exposto via Traefik em /agent)
AGENT_HTTP_PORT=8085
