# ===================================================================
# CREDGESTOR STAGING - Variáveis de Ambiente
# ===================================================================
# Copie este arquivo para .env e preencha com seus valores
# cp staging/.env.example staging/.env
#
# URL: https://staging.credgestor.app.br
# API local: http://127.0.0.1:8001

# ===================================================================
# BACKEND - Supabase
# ===================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DEFAULT_TENANT_ID=

# ===================================================================
# BACKEND LEGACY - PostgreSQL
# ===================================================================
DATABASE_URL=

# ===================================================================
# FRONTEND (referência — bake no build da imagem)
# ===================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=https://staging.credgestor.app.br/api
VITE_N8N_BASE_URL=

# ===================================================================
# DOCKER
# ===================================================================
API_HOST=0.0.0.0
API_PORT=8000
DOCKER_VERSION=latest

# ===================================================================
# OpenTelemetry (opcional)
# ===================================================================
OTEL_SERVICE_NAME=credgestor-api-staging
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
