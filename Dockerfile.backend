# Dockerfile para Backend CredGestor (FastAPI)
FROM python:3.11-slim as builder

# Instalar dependências de build
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar e instalar dependências Python
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ===================================================================
# STAGE 2: Runtime
# ===================================================================
FROM python:3.11-slim

# Build arguments para metadata
ARG BUILD_DATE
ARG GIT_SHA
ARG GIT_REF

# Labels para metadata
LABEL maintainer="CredGestor Team"
LABEL description="CredGestor Backend API"
LABEL version="1.0.0"
LABEL build.date="${BUILD_DATE}"
LABEL build.git.sha="${GIT_SHA}"
LABEL build.git.ref="${GIT_REF}"

# Criar usuário não-root
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app && \
    chown -R appuser:appuser /app

# Instalar apenas runtime dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Copiar dependências do builder
COPY --from=builder /root/.local /home/appuser/.local
COPY --chown=appuser:appuser backend/ ./backend/

# Adicionar .local ao PATH
ENV PATH=/home/appuser/.local/bin:$PATH

# Mudar para usuário não-root
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expor porta
EXPOSE 8000

# Variáveis de ambiente padrão
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Comando padrão
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
