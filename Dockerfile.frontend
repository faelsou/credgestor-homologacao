# Dockerfile para Frontend CredGestor (React + Vite)
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar arquivos de dependências
COPY package*.json ./

# Instalar dependências
RUN npm ci --only=production=false

# Copiar código fonte
COPY . .

# Build da aplicação
# Variáveis do Vite (opcionais - podem ser vazias)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE_URL
ARG VITE_N8N_BASE_URL
# Metadata de build (opcionais)
ARG BUILD_DATE
ARG GIT_SHA
ARG GIT_REF

# Variáveis de ambiente para build (Vite usa variáveis de ambiente em build time)
# Usa valor padrão vazio se não fornecido
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL:-}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY:-}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL:-}
ENV VITE_N8N_BASE_URL=${VITE_N8N_BASE_URL:-}
# Metadata (não usado no build, apenas para labels)
ENV BUILD_DATE=${BUILD_DATE:-}
ENV GIT_SHA=${GIT_SHA:-}
ENV GIT_REF=${GIT_REF:-}

RUN npm run build

# ===================================================================
# STAGE 2: Nginx
# ===================================================================
FROM nginx:alpine

# Labels para metadata
LABEL maintainer="CredGestor Team"
LABEL description="CredGestor Frontend"
LABEL version="1.0.0"
LABEL build.date="${BUILD_DATE:-}"
LABEL build.git.sha="${GIT_SHA:-}"
LABEL build.git.ref="${GIT_REF:-}"

# Copiar build do frontend
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar configuração customizada do nginx
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Instalar wget para healthcheck (nginx:alpine não inclui wget por padrão)
RUN apk add --no-cache wget

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Expor porta
EXPOSE 80

# Comando padrão
CMD ["nginx", "-g", "daemon off;"]
